# Environment contract for the BYO-token provider smoke run.
#
# Copy to a location outside the repository, fill in the values, source it, and run:
#   bash eng/provider-smoke/run-provider-smoke.sh --provider byo
#
# These files hold real bearer tokens. Keep them outside the repository and delete them when done.

# Byte-exact issuer, exactly as the provider publishes it (authentik: include the trailing slash).
SMOKE_ISSUER=https://authentik.example.com/application/o/mcpiler-production/

# jwks or introspection.
SMOKE_VALIDATION=jwks

# Exact canonical MCP resource audience of the smoke surface, for example:
#   https://mcp.example.com/api/interop
SMOKE_AUDIENCE=https://mcp.example.com/api/interop

# 1 to enable the constrained OIDC discovery fallback; it fires only on an exact 404/410 of the
# RFC 8414 route. Older authentik material suggested it was always needed — authentik 2026.8.4
# serves RFC 8414 directly, so verify the provider's metadata route before enabling.
SMOKE_OIDC_FALLBACK=1

# One real provider-issued bearer for the caller client, stored in a file.
SMOKE_VALID_TOKEN_FILE=/secure/smoke/valid.token

# Optional negative tokens minted by the same provider with another audience / without the scope.
SMOKE_WRONG_AUDIENCE_TOKEN_FILE=/secure/smoke/wrong-audience.token
SMOKE_WRONG_SCOPE_TOKEN_FILE=/secure/smoke/wrong-scope.token

# Only for SMOKE_VALIDATION=introspection: the resource-server client credential Engine presents.
SMOKE_INTROSPECTION_CLIENT_ID=mcp-engine-resource-server
SMOKE_INTROSPECTION_CLIENT_SECRET_FILE=/secure/smoke/introspection-secret

# Optional explicit endpoint overrides (usually omit and let discovery answer).
#SMOKE_JWKS_URI=https://authentik.example.com/application/o/mcpiler-production/jwks/
#SMOKE_INTROSPECTION_ENDPOINT=https://authentik.example.com/application/o/mcpiler-prod/introspect/
