{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcpiler:manifest:0.1:credentials",
  "title": "MCPiler Manifest credentials section",
  "description": "Credential declarations carrying references, never secret material.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 1 },
    "credentials": {
      "type": "array",
      "items": { "$ref": "#/$defs/credential" }
    }
  },
  "$defs": {
    "credential": {
      "type": "object",
      "required": ["scheme", "slot", "value"],
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "$comment": "'none' appears in Studio doc comments but matches no applier branch, so admitting it here would describe a silent no-op as a configuration.",
          "enum": ["basic", "bearer", "apiKey", "header"]
        },
        "slot": {
          "description": "basic: 'username' or 'password'. bearer: the header name. apiKey/header: the header, query or cookie name.",
          "type": "string"
        },
        "location": {
          "description": "Meaningful for apiKey only; defaults to header.",
          "enum": ["header", "query", "cookie"]
        },
        "value": { "$ref": "#/$defs/reference" }
      }
    },
    "reference": {
      "description": "Exactly one variant. 'inline' is refused unless Engine is started with the explicit opt-in.",
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "required": ["fromEnv"],
          "additionalProperties": false,
          "properties": { "fromEnv": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["fromFile"],
          "additionalProperties": false,
          "properties": { "fromFile": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["inline"],
          "additionalProperties": false,
          "properties": { "inline": { "type": "string" } }
        }
      ]
    }
  }
}
