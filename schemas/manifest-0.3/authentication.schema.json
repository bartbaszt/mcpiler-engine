{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcpiler:manifest:0.3:authentication",
  "title": "MCPiler Manifest 0.3 authentication section",
  "description": "Generic authentication profiles carrying closed, non-secret strategy configuration. No member here can hold a Platform row id, a preset or product id, a ciphertext, or a secret value.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 1 },
    "profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["id", "kind", "configuration", "authenticationOrigins", "destinationOrigins", "credentialRef"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$comment": "The same charset as a credential id, so one identity rule covers the whole format.",
          "description": "Referenced by an http binding's authenticationRef. Carries no runtime meaning beyond selecting the profile.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 64
        },
        "kind": {
          "$comment": "'reviewed-composite' is part of the vocabulary so a stored value round-trips, but no accepted artifact defines its runtime semantics, so a profile declaring it is refused at load.",
          "enum": [
            "static",
            "oauth2-client-credentials",
            "oauth2-authorization-code-pkce-refresh",
            "token-session-exchange",
            "challenge-session",
            "request-signing",
            "reviewed-composite"
          ]
        },
        "configuration": {
          "description": "The bounded strategy configuration. Its member set is selected by 'kind' and closed for every kind.",
          "type": "object"
        },
        "authenticationOrigins": {
          "description": "Canonical origins that may receive the credential while authenticating.",
          "type": "array",
          "items": { "$ref": "#/$defs/origin" }
        },
        "destinationOrigins": {
          "description": "Canonical origins that may receive the request the credential is applied to.",
          "type": "array",
          "items": { "$ref": "#/$defs/origin" }
        },
        "credentialRef": {
          "description": "Credentials-section ids this profile reveals. An unknown id is refused.",
          "type": "array",
          "items": { "type": "string" }
        },
        "scopeFingerprint": {
          "description": "The producer's non-secret scope/config fingerprint. Engine compares it only for equality when binding a local runtime record.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "slots": {
          "description": "Mutable-slot authority state, for kinds that own a writable slot.",
          "type": "array",
          "items": { "$ref": "#/$defs/slot" }
        }
      },
      "allOf": [
        { "$ref": "#/$defs/staticOrCompositeShape" },
        { "$ref": "#/$defs/oauthShape" },
        { "$ref": "#/$defs/exchangeShape" },
        { "$ref": "#/$defs/challengeShape" },
        { "$ref": "#/$defs/signingShape" }
      ]
    },
    "slot": {
      "type": "object",
      "required": ["slot", "authorityEpoch"],
      "additionalProperties": false,
      "properties": {
        "slot": {
          "description": "The slot identity within the profile, for example 'refreshToken'.",
          "type": "string"
        },
        "authorityEpoch": {
          "description": "The non-secret authority epoch. An explicit Platform reauthorization, clear, replacement or scope change advances it; ordinary runtime rotation does not.",
          "type": "integer",
          "minimum": 0
        },
        "runtimeRevision": {
          "description": "The monotonic runtime revision within one authority epoch.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "origin": {
      "$comment": "Canonical only. A path, query or fragment would make origin comparison depend on how two URLs were written.",
      "description": "scheme://host[:port], or the reviewed https://*.parent wildcard form on destination origins.",
      "type": "string",
      "maxLength": 2048,
      "pattern": "^(https?://(\\*\\.)?[^/:?#\\\\%\\s]+(:[0-9]{1,5})?)$"
    },
    "staticOrCompositeShape": {
      "description": "The static and reserved-composite kinds carry only the producer strategy id and non-secret inputs.",
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "enum": ["static", "reviewed-composite"] } }
      },
      "then": { "properties": { "configuration": { "$ref": "#/$defs/inputsConfiguration" } } }
    },
    "oauthShape": {
      "description": "The two OAuth kinds share a closed member set.",
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "enum": ["oauth2-client-credentials", "oauth2-authorization-code-pkce-refresh"] } }
      },
      "then": { "properties": { "configuration": { "$ref": "#/$defs/oauthConfiguration" } } }
    },
    "exchangeShape": {
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "const": "token-session-exchange" } }
      },
      "then": { "properties": { "configuration": { "$ref": "#/$defs/exchangeConfiguration" } } }
    },
    "challengeShape": {
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "const": "challenge-session" } }
      },
      "then": { "properties": { "configuration": { "$ref": "#/$defs/challengeConfiguration" } } }
    },
    "signingShape": {
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "const": "request-signing" } }
      },
      "then": { "properties": { "configuration": { "$ref": "#/$defs/signingConfiguration" } } }
    },
    "inputsConfiguration": {
      "type": "object",
      "required": ["strategyId", "inputs"],
      "additionalProperties": false,
      "properties": {
        "strategyId": { "type": "string" },
        "inputs": { "$ref": "#/$defs/nonSecretInputs" }
      }
    },
    "nonSecretInputs": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "oauthConfiguration": {
      "type": "object",
      "required": ["tokenEndpoint"],
      "additionalProperties": false,
      "properties": {
        "strategyId": { "type": "string" },
        "inputs": { "$ref": "#/$defs/nonSecretInputs" },
        "clientId": { "type": "string", "maxLength": 500 },
        "tokenEndpoint": { "$ref": "#/$defs/absoluteUrl" },
        "authorizationEndpoint": { "$ref": "#/$defs/absoluteUrlNullable" },
        "revocationEndpoint": { "$ref": "#/$defs/absoluteUrlNullable" },
        "tokenAuthMethod": { "enum": ["client_secret_post", "client_secret_basic", "none"] },
        "scopes": {
          "type": "array",
          "items": { "type": "string", "maxLength": 500 }
        },
        "resource": { "type": "string", "maxLength": 2000 },
        "audience": { "type": "string", "maxLength": 2000 },
        "accessTokenSafetySkewSeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
        "authorizationParameters": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 2000 },
          "propertyNames": { "maxLength": 200 }
        }
      }
    },
    "exchangeConfiguration": {
      "type": "object",
      "required": ["strategyId", "endpoint", "method", "request", "response", "injection"],
      "additionalProperties": false,
      "properties": {
        "strategyId": { "type": "string" },
        "inputs": { "$ref": "#/$defs/nonSecretInputs" },
        "endpoint": { "$ref": "#/$defs/absoluteUrl" },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH"] },
        "request": {
          "type": "object",
          "required": ["mediaType"],
          "additionalProperties": false,
          "properties": {
            "mediaType": { "enum": ["application/json", "application/x-www-form-urlencoded"] },
            "fields": { "$ref": "#/$defs/valueMappings" },
            "headers": { "$ref": "#/$defs/valueMappings" },
            "basic": {
              "type": "object",
              "required": ["username", "password"],
              "additionalProperties": false,
              "properties": {
                "username": { "$ref": "#/$defs/valueMapping" },
                "password": { "$ref": "#/$defs/valueMapping" }
              }
            }
          }
        },
        "response": {
          "type": "object",
          "required": ["token"],
          "additionalProperties": false,
          "properties": {
            "token": { "$ref": "#/$defs/selector" },
            "expiry": {
              "type": "object",
              "required": ["kind", "source", "selector"],
              "additionalProperties": false,
              "properties": {
                "kind": { "enum": ["relativeSeconds", "unixSeconds", "absoluteUtc"] },
                "source": { "enum": ["jsonPointer", "header", "cookie"] },
                "selector": { "type": "string", "maxLength": 500 }
              }
            }
          }
        },
        "injection": { "$ref": "#/$defs/injection" },
        "destination": {
          "type": "object",
          "required": ["selector", "allowedOrigins"],
          "additionalProperties": false,
          "properties": {
            "selector": { "$ref": "#/$defs/selector" },
            "allowedOrigins": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/origin" }
            }
          }
        },
        "defaultLifetimeSeconds": { "type": "integer", "minimum": 1, "maximum": 2592000 },
        "safetySkewSeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
        "authFailureStatusCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "integer", "minimum": 400, "maximum": 599 }
        }
      }
    },
    "challengeConfiguration": {
      "type": "object",
      "required": ["strategyId", "challenge", "injection"],
      "additionalProperties": false,
      "properties": {
        "strategyId": { "type": "string" },
        "inputs": { "$ref": "#/$defs/nonSecretInputs" },
        "challenge": {
          "type": "object",
          "required": ["source", "selector"],
          "additionalProperties": false,
          "properties": {
            "statusCodes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": { "type": "integer", "minimum": 400, "maximum": 599 }
            },
            "source": { "enum": ["header", "cookie"] },
            "selector": { "type": "string", "maxLength": 200 }
          }
        },
        "injection": { "$ref": "#/$defs/injection" },
        "replaySafeOperationKeys": {
          "type": "array",
          "maxItems": 500,
          "items": { "type": "string", "maxLength": 2048 }
        },
        "sessionLifetimeSeconds": { "type": "integer", "minimum": 1, "maximum": 2592000 }
      }
    },
    "signingConfiguration": {
      "type": "object",
      "required": ["strategyId", "inputs"],
      "additionalProperties": false,
      "properties": {
        "strategyId": {
          "$comment": "The strategy id names a reviewed signer. A signer Engine does not implement is refused at load.",
          "enum": [
            "request-signing-aws-sigv4",
            "request-signing-hmac",
            "request-signing-jwt-hmac",
            "request-signing-subsonic-md5"
          ]
        },
        "inputs": {
          "type": "object",
          "required": ["accessKeyId"],
          "additionalProperties": false,
          "properties": {
            "accessKeyId": { "type": "string" }
          }
        }
      }
    },
    "valueMappings": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/valueMapping" }
    },
    "valueMapping": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["input", "secret", "static"] },
        "slot": { "type": "string", "maxLength": 200 },
        "value": { "type": "string", "maxLength": 16384 }
      }
    },
    "selector": {
      "type": "object",
      "required": ["source", "selector"],
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["jsonPointer", "header", "cookie"] },
        "selector": { "type": "string", "maxLength": 500 }
      }
    },
    "injection": {
      "type": "object",
      "required": ["location"],
      "additionalProperties": false,
      "properties": {
        "location": { "enum": ["bearer", "header", "cookie", "query"] },
        "name": { "type": "string", "maxLength": 200 },
        "prefix": { "type": "string", "maxLength": 200 }
      }
    },
    "absoluteUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https?://[^\\s]+$"
    },
    "absoluteUrlNullable": {
      "type": ["string", "null"],
      "maxLength": 2048
    }
  }
}
