<Project>

  <!--
    Central package versions for MCPiler Engine.

    Engine's dependency graph is deliberately small and permissively licensed. The
    following MUST NOT appear here: any OpenAPI/Postman/cURL parser, any YAML parser,
    Entity Framework Core, or any UI/component library. Engine consumes a compiled
    MCPiler Manifest; it never interprets a source API description.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.167" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
  </ItemGroup>

  <ItemGroup Label="Runtime">
    <!--
      The Model Context Protocol SDK. Engine speaks the protocol rather than defining it,
      and framing, negotiation and error shapes are the SDK's to own on both transports.
      Hand-rolling them would put Engine and the Studio on two implementations of one wire
      contract, which is the divergence this whole split exists to avoid. Same package and
      same version the Studio consumes, deliberately.
    -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.2.0" />

    <!--
      Runtime as of the MCP host. Two obligations need a real evaluator: validating
      structured content against the schema that was advertised, and validating arguments
      against an operation's input schema before anything is compiled. Both are decisions
      about what a client sent, so neither can be deferred to a producer.

      It remains the evaluator the schema tests use, which is the point: the published
      JSON Schemas under schemas/ and the readers in Manifest/Loading are checked against
      the same semantics the runtime applies. MIT licensed, and the same evaluator the
      Studio uses, so the two implementations agree on JSON Schema by construction rather
      than by comparison.
    -->
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />

    <!--
      Runtime as of the authorization boundary. JWKS validation needs a token security
      library: signature and lifetime checking that is maintained against the JOSE
      ecosystem rather than reimplemented here. MIT licensed. Used only by the host
      deployable's configured token-validation mode; introspection mode ships without
      reaching it.
    -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

</Project>
