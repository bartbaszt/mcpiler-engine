<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Engine's deployable. The library beside it decides what to serve; this project
    decides how it is reached - a command line, a listener, a transport, a container
    entry point. Everything the product means lives in the library, and an architecture
    guard asserts that separation rather than trusting it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MCPiler.Engine.Host</RootNamespace>
    <AssemblyName>mcpiler-engine</AssemblyName>
    <Version>0.0.1-alpha</Version>

    <!--
      Never packed. Engine's public contract is this executable's command line and the
      Manifest format, not a .NET API surface. The flag is not a consequence of the 0.x
      version window; nobody is invited to reference the assembly at all.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MCPiler.Engine.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MCPiler.Engine/MCPiler.Engine.csproj" />
  </ItemGroup>

  <!--
    The protocol SDK is referenced by the deployable and not by the library. Framing,
    negotiation, session handling and error shapes are the SDK's; what to advertise and what
    an invocation means stay on the other side of the line, which is why the library needs
    no protocol package at all.

    Token security is referenced here for the same reason: the configured JWKS validation
    mode is a property of the deployable's authorization boundary, and the library's seam
    stays free of JOSE types.
  -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
