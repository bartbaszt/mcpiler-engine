<Project>

  <!--
    MCPiler Engine build baseline. This file is intentionally self-contained: the Engine
    repository MUST restore, build and test from a standalone checkout and MUST NOT
    depend on any file outside its own root, in particular not on a parent-directory
    Directory.Build.props belonging to a superproject that embeds Engine as a submodule.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Quality baseline: compiler, SDK analyzers, and explicitly enabled third-party
         analyzer diagnostics participate in every project build. -->
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Meziantou ships many useful rules but also opinionated design/style rules.
         Start from none and opt in to the curated rules in .editorconfig. -->
    <MeziantouAnalysisMode>None</MeziantouAnalysisMode>

    <!-- Reproducible builds matter for a runtime whose artifacts are meant to be verifiable. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />

    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <!--
    The JMESPath evaluator's runtime package ships a production code analyzer (CTJ001 and
    friends) that activates wherever its runtime assets are consumed. Engine consumes those
    assets unmodified for language semantics, but the analyzer is not part of this
    repository's curated analyzer posture: the rules are style and performance opinions
    about Corvus-specific APIs, and they fire on Engine sources that predate the reference.

    NuGet cannot express this as an exclusion: the analyzer arrives on the evaluator's
    transitive dependency edge, and ExcludeAssets on the direct reference does not reach a
    transitive one (verified against the SDK's resolved asset graph). Removing the item at
    the point the SDK has resolved it is the one place every project in this repository is
    covered without repeating the rule, and without a per-diagnostic suppression list that
    would have to grow every time the dependency adds a rule. Runtime IL is untouched;
    only build-time analysis is.
  -->
  <Target Name="RemoveDependencyAnalyzers"
          AfterTargets="ResolveLockFileAnalyzers"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'Corvus.Text.Json'" />
    </ItemGroup>
  </Target>

</Project>
