      "expectedBaseStringUri": "https://example.com/",
      "covers": ["empty-path"]
    },
    {
      "id": "extra-question-mark-in-query",
      "source": "Independent golden: Uri.Query keeps the delimiter '?', so https://example.test/path??a=1 has query component \"?a=1\" (parameter name \"?a\"). Removing every leading '?' would incorrectly rename it to \"a\".",
      "uri": "https://example.test/path??a=1&b=2",
      "decodedPairs": [["?a", "1"], ["b", "2"]],
      "expectedNormalizedParameters": "%3Fa=1&b=2",
      "expectedBaseStringUri": "https://example.test/path",
      "covers": ["delimiter-question-mark"]
    }
