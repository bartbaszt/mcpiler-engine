  "parameterCases": [
    {
      "id": "duplicate-name-value-sort",
      "wireEncoded": "name=z&name=a",
      "decodedPairs": [["name", "z"], ["name", "a"]],
      "expectedNormalizedParameters": "name=a&name=z",
      "covers": ["duplicate-names"]
    },
    {
      "id": "empty-name-and-values",
      "wireEncoded": "=empty-name&empty=&empty",
      "decodedPairs": [["", "empty-name"], ["empty", ""], ["empty", ""]],
      "expectedNormalizedParameters": "=empty-name&empty=&empty=",
      "covers": ["empty-names", "empty-values"]
    },
    {
      "id": "form-plus-equals-percent20",
      "wireEncoded": "q=white+space&q=white%20space",
      "decodedPairs": [["q", "white space"], ["q", "white space"]],
      "expectedNormalizedParameters": "q=white%20space&q=white%20space",
      "covers": ["plus-versus-percent20"]
    },
    {
      "id": "already-encoded-octets",
      "wireEncoded": "b5=%3D%253D&encoded=%252F&literal=%2F&plus=%2B",
      "decodedPairs": [["b5", "=%3D"], ["encoded", "%2F"], ["literal", "/"], ["plus", "+"]],
      "expectedNormalizedParameters": "b5=%3D%253D&encoded=%252F&literal=%2F&plus=%2B",
      "covers": ["already-encoded-octets"]
    },
    {
      "id": "utf8-unicode-pairs",
      "wireEncoded": "%F0%9F%8C%8A=%C3%A9&caf%C3%A9=%E6%9D%B1%E4%BA%AC",
      "decodedPairs": [["🌊", "é"], ["café", "東京"]],
      "expectedNormalizedParameters": "%F0%9F%8C%8A=%C3%A9&caf%C3%A9=%E6%9D%B1%E4%BA%AC",
      "covers": ["unicode"]
    },
    {
      "id": "default-http-port",
      "uri": "http://EXAMPLE.COM:80/resource?ignored=1#fragment",
      "expectedBaseStringUri": "http://example.com/resource",
      "covers": ["default-port"]
    },
    {
      "id": "non-default-https-port",
