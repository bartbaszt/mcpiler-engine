          "inline": {
            "formatVersion": 4,
            "operations": [
              {
                "slug": "inspect_metadata",
                "name": "Inspect metadata",
                "inputSchema": { "type": "object", "properties": {} },
                "outputSchema": { "type": "object" },
                "outputSchemaPolicy": { "generate": false, "advertise": "yes", "useInternally": true },
                "binding": { "type": "http", "operation": "GET /metadata" },
                "outputProjection": {
                  "bodyTarget": "/data",
                  "metadata": [
                    { "source": { "kind": "responseHeader", "name": "etag", "valueMode": "first" }, "target": "/metadata/etag" },
                    { "source": { "kind": "responseHeader", "name": "x-label", "valueMode": "all" }, "target": "/metadata/labels" },
                    { "source": { "kind": "responseHeader", "name": "x-large", "valueMode": "first" }, "target": "/metadata/large" },
                    { "source": { "kind": "responseHeader", "name": "x-other-a", "valueMode": "first" }, "target": "/metadata/a" },
                    { "source": { "kind": "responseHeader", "name": "x-other-b", "valueMode": "first" }, "target": "/metadata/b" },
                    { "source": { "kind": "responseHeader", "name": "retry-after", "valueMode": "first" }, "target": "/metadata/retryAfter" },
                    { "source": { "kind": "statusCode" }, "target": "/metadata/status" }
                  ]
                }
              },
              {
                "slug": "list_items",
                "name": "List items",
                "inputSchema": {
                  "type": "object",
                  "required": ["account"],
                  "properties": { "account": { "type": "string" }, "cursor": { "type": "string" } }
