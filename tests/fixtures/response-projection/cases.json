                "outputSchema": { "type": "object" },
                "outputSchemaPolicy": { "generate": false, "advertise": "yes", "useInternally": true },
                "binding": { "type": "http", "operation": "GET /items" },
                "outputProjection": {
                  "bodyTarget": "/data",
                  "metadata": [
                    { "source": { "kind": "responseHeader", "name": "retry-after", "valueMode": "first" }, "target": "/metadata/retryAfter" }
                  ],
                  "pagination": {
                    "target": "/pagination",
                    "source": { "kind": "responseHeader", "name": "x-next-cursor", "scalarType": "string" },
                    "nextArguments": [
                      { "target": "/account", "from": { "kind": "currentArgument", "pointer": "/account" }, "as": "string" },
                      { "target": "/cursor", "from": { "kind": "extractedValue" }, "as": "string" }
                    ]
                  }
                }
              },
              {
                "slug": "body_cursor_items",
                "name": "Body cursor items",
                "inputSchema": {
                  "type": "object",
                  "required": ["account"],
                  "properties": {
                    "account": { "type": "string" },
                    "cursor": { "type": "string" },
                    "tenant": { "type": "string" }
