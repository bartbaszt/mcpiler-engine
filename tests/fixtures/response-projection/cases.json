                  "type": "transformedHttp",
                  "base": { "operation": "GET /items" },
                  "inputProgram": {
                    "transformVersion": 1,
                    "direction": "input",
                    "base": "empty",
                    "limits": { "maxSteps": 32, "maxDepth": 16, "maxNodes": 4096, "maxOutputBytes": 131072, "maxArrayFanout": 256 },
                    "steps": [
                      { "op": "copy", "source": "/account", "target": "/query/account" },
                      { "op": "copy", "source": "/cursor", "target": "/query/cursor", "onMissing": "skip" }
                    ]
                  },
                  "outputProgram": {
                    "transformVersion": 1,
                    "direction": "output",
                    "base": "passthrough",
                    "limits": { "maxSteps": 32, "maxDepth": 16, "maxNodes": 4096, "maxOutputBytes": 131072, "maxArrayFanout": 256 },
                    "steps": [
                      { "op": "copy", "source": "/body", "target": "" },
                      { "op": "omit", "target": "/paging" }
                    ]
                  }
                },
                "outputProjection": {
                  "bodyTarget": "/data",
                  "pagination": {
                    "target": "/pagination",
                    "source": { "kind": "jsonPointer", "pointer": "/paging/nextCursor", "interpretation": "value" },
                    "nextArguments": [
                      { "target": "/account", "from": { "kind": "currentArgument", "pointer": "/account" }, "as": "string" },
                      { "target": "/cursor", "from": { "kind": "extractedValue" }, "as": "string" },
                      { "target": "/tenant", "from": { "kind": "literal", "value": "acme" }, "as": "string" }
                    ]
                  }
                }
              },
              {
                "slug": "search_items",
                "name": "Search items",
                "inputSchema": {
                  "type": "object",
                  "required": ["account", "q"],
                  "properties": { "account": { "type": "string" }, "q": { "type": "string" } }
                },
                "outputSchema": { "type": "object" },
                "outputSchemaPolicy": { "generate": false, "advertise": "yes", "useInternally": true },
                "binding": {
                  "type": "transformedHttp",
                  "base": { "operation": "GET /search" },
                  "inputProgram": {
                    "transformVersion": 1,
                    "direction": "input",
                    "base": "empty",
                    "limits": { "maxSteps": 32, "maxDepth": 16, "maxNodes": 4096, "maxOutputBytes": 131072, "maxArrayFanout": 256 },
                    "steps": [
                      { "op": "copy", "source": "/account", "target": "/query/account" },
                      { "op": "copy", "source": "/q", "target": "/query/q" }
                    ]
                  },
                  "outputProgram": {
                    "transformVersion": 1,
                    "direction": "output",
                    "base": "passthrough",
                    "limits": { "maxSteps": 32, "maxDepth": 16, "maxNodes": 4096, "maxOutputBytes": 131072, "maxArrayFanout": 256 },
                    "steps": [
                      { "op": "copy", "source": "/body", "target": "" },
                      { "op": "omit", "target": "/paging" }
                    ]
                  }
                },
                "outputProjection": {
                  "bodyTarget": "/data",
                  "pagination": {
                    "target": "/pagination",
                    "source": { "kind": "linkHeader", "header": "link", "relation": "next" },
                    "nextOperation": "list_items_page",
                    "nextArguments": [
                      { "target": "/account", "from": { "kind": "urlPathParameter", "name": "account" }, "as": "string" },
                      { "target": "/cursor", "from": { "kind": "urlQuery", "name": "cursor" }, "as": "string" }
                    ]
                  }
                }
              },
              {
                "slug": "next_url_items",
