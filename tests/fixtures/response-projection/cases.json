                "binding": { "type": "http", "operation": "GET /metadata" },
                "outputProjection": {
                  "bodyTarget": "/data",
                  "pagination": {
                    "target": "/pagination",
                    "source": { "kind": "jsonPointer", "pointer": "/nextUrl", "interpretation": "url" },
                    "nextOperation": "list_items_page",
                    "nextArguments": [
                      { "target": "/account", "from": { "kind": "urlPathParameter", "name": "account" }, "as": "string" },
                      { "target": "/cursor", "from": { "kind": "urlQuery", "name": "cursor" }, "as": "string" }
                    ]
                  }
