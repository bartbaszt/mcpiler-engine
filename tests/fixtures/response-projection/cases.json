{
  "corpusVersion": 1,
  "excludedFromExactComparison": [],
  "directives": {
    "$repeatUtf8": {
      "fields": ["text", "bytes"],
      "meaning": "Resolves to a UTF-8 string produced by repeating the literal 'text' until its UTF-8 byte length equals 'bytes'."
    },
    "$repeatArray": {
      "fields": ["value", "count"],
      "meaning": "Resolves to an array containing the literal 'value' exactly 'count' times, in order."
    },
    "$concatUtf8": {
      "fields": ["parts"],
      "meaning": "Resolves to a UTF-8 string produced by concatenating the resolved array elements, in order."
    }
  },
  "semantics": {
    "evaluation": "Platform preview/compilation and Engine runtime both resolve directives, evaluate the declared Manifest policy against the declared bounded response, and produce the expected final projected JSON value together with the expected stable diagnostic codes. Directive objects are resolved recursively in both the response fixture and the expected value before evaluation/comparison.",
    "responseShape": "response.headers is an ordered list; entries sharing a name contribute their values in order to that field, and name lookup is ASCII case-insensitive. response.status is the upstream status code, response.effectiveUri is the final effective response URI after redirects, and response.body is the bounded upstream JSON body before output transformation.",
    "expectedShape": "expected.result is the final projected agent value before MCP text/structured-content framing; it is absent when the case expects a Manifest-load refusal instead. expected.loadRefusal is true when the declared Manifest must be refused before serving. expected.diagnostics lists stable diagnostic codes in the order the implementation must produce them.",
    "aggregateRefusal": "Per-value and per-count ceilings refuse only the affected mapping. A raw-header-aggregate or serialized-aggregate breach omits every header-derived metadata mapping while non-header generic mappings (such as statusCode) remain. Pagination keeps its own independent ceilings: exceeding the parsed link-value count, the resolved continuation URL size, or the serialized normalized pagination object size makes pagination unavailable without altering generic metadata.",
    "comparison": "Every expected result is compared to the produced result by canonical serialized JSON bytes: object members are ordered by ordinal member name at every depth, insignificant whitespace is absent, array order is preserved, and number tokens retain the corpus-declared lexical value.",
    "loadRefusalCodes": "Cases with loadRefusalScope declare exact error diagnostic codes the Engine Manifest reader/validator must emit."
  },
  "manifests": {
    "projection-v4": {
      "manifestFormatVersion": "0.3",
      "sections": {
        "server": {
          "inline": {
            "formatVersion": 2,
            "name": "Response Projection Fixture",
            "surfaces": [
              {
                "slug": "direct",
                "isDefault": true,
                "outputSchemas": true,
                "operations": [
                  { "operation": "inspect_metadata", "exposure": "direct" },
                  { "operation": "list_items", "exposure": "direct" },
                  { "operation": "body_cursor_items", "exposure": "direct" },
                  { "operation": "search_items", "exposure": "direct" },
                  { "operation": "next_url_items", "exposure": "direct" },
                  { "operation": "list_items_page", "exposure": "direct" }
                ]
              },
              {
                "slug": "navigator",
                "navigator": { "enabled": true, "pageSize": 10 },
                "outputSchemas": true,
                "operations": [
                  { "operation": "inspect_metadata", "exposure": "direct" },
                  { "operation": "list_items", "exposure": "direct" },
                  { "operation": "body_cursor_items", "exposure": "direct" },
                  { "operation": "search_items", "exposure": "direct" },
                  { "operation": "next_url_items", "exposure": "direct" },
                  { "operation": "list_items_page", "exposure": "navigator" }
                ]
              }
            ]
          }
        },
        "policy": {
          "inline": {
            "formatVersion": 1,
            "baseUrl": "https://api.example",
            "allowedOrigins": ["https://api.example"]
          }
        },
        "operations": {
          "inline": {
            "formatVersion": 1,
            "servers": ["https://api.example"],
            "operations": [
              {
                "key": "GET /metadata",
                "method": "GET",
                "path": "/metadata",
                "responses": {
                  "200": { "content": { "application/json": { "schema": { "type": "object" } } } }
                }
              },
              {
                "key": "GET /items",
                "method": "GET",
                "path": "/items",
                "parameters": [
                  { "name": "account", "in": "query", "required": true, "schema": { "type": "string" } },
                  { "name": "cursor", "in": "query", "schema": { "type": "string" } }
                ],
                "responses": {
                  "200": { "content": { "application/json": { "schema": { "type": "object" } } } }
                }
              },
              {
                "key": "GET /search",
                "method": "GET",
                "path": "/search",
                "parameters": [
                  { "name": "account", "in": "query", "required": true, "schema": { "type": "string" } },
                  { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } }
                ],
                "responses": {
                  "200": { "content": { "application/json": { "schema": { "type": "object" } } } }
                }
              },
              {
                "key": "GET /v2/accounts/{account}/items",
                "method": "GET",
                "path": "/v2/accounts/{account}/items",
                "parameters": [
                  { "name": "account", "in": "path", "required": true, "schema": { "type": "string" } },
                  { "name": "cursor", "in": "query", "required": true, "schema": { "type": "string" } }
                ],
                "responses": {
                  "200": { "content": { "application/json": { "schema": { "type": "object" } } } }
                }
              }
            ]
          }
        },
