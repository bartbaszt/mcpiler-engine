{
  "manifestFormatVersion": "0.3",
  "sections": {
    "server": {
      "inline": {
        "name": "Two Origins",
        "description": "One connector reaching two upstream origins, each with its own bearer token.",
        "surfaces": [
          {
            "slug": "default",
            "isDefault": true,
            "operations": [
              { "operation": "list-pets", "exposure": "direct" },
              { "operation": "list-shops", "exposure": "direct" }
            ]
          }
        ]
      }
    },
    "policy": {
      "inline": {
        "baseUrl": "https://api.example.com/v1",
        "allowedOrigins": ["https://api.example.com", "https://eu.example.com"]
      }
    },
    "operations": {
      "inline": {
        "operations": [
          { "key": "GET /pets", "method": "GET", "path": "/pets" },
          { "key": "GET /shops", "method": "GET", "path": "/shops" }
        ]
      }
    },
    "agentSurface": {
      "inline": {
        "formatVersion": 5,
        "operations": [
          {
            "slug": "list-pets",
            "name": "List pets",
            "binding": {
              "type": "http",
              "operation": "GET /pets",
              "credentialRef": ["pets-token"]
            }
          },
          {
            "slug": "list-shops",
            "name": "List shops",
            "binding": {
              "type": "http",
              "operation": "GET /shops",
              "serverUrl": "https://eu.example.com/v1",
              "credentialRef": ["shops-token"]
            }
          }
        ]
      }
    },
    "credentials": {
      "inline": {
        "formatVersion": 4,
        "credentials": [
          {
            "id": "pets-token",
            "scheme": "bearer",
            "slot": "Authorization",
            "value": { "fromEnv": "PETS_TOKEN" }
          },
          {
            "id": "shops-token",
            "scheme": "bearer",
            "slot": "Authorization",
            "value": { "fromEnv": "SHOPS_TOKEN" }
          }
        ]
      }
    }
  }
}
