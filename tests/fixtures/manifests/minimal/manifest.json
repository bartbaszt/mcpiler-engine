{
  "manifestFormatVersion": "0.3",
  "sections": {
    "server": { "inline": {
      "name": "Example API",
      "authenticationRequired": false
    } },
    "policy": { "inline": { "baseUrl": "https://api.example.com" } },
    "operations": {
      "inline": {
        "operations": [
          { "key": "GET /pets", "method": "GET", "path": "/pets" }
        ]
      }
    },
    "agentSurface": {
      "inline": {
        "operations": [
          {
            "slug": "list-pets",
            "name": "List pets",
            "binding": { "type": "http", "operation": "GET /pets" }
          }
        ]
      }
    }
  }
}
