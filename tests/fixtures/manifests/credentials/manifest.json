{
  "manifestFormatVersion": "0.1",
  "sections": {
    "server": {
      "inline": {
        "name": "Credential Matrix",
        "surfaces": [
          {
            "slug": "default",
            "isDefault": true,
            "operations": [{ "operation": "ping", "exposure": "direct" }]
          }
        ]
      }
    },
    "policy": { "inline": { "baseUrl": "https://api.example.com" } },
    "operations": {
      "inline": {
        "operations": [
          {
            "key": "GET /ping",
            "method": "GET",
            "path": "/ping",
            "responses": {
              "200": { "content": { "application/json": { "schema": { "type": "object" } } } }
            }
          }
        ]
      }
    },
    "agentSurface": {
      "inline": {
        "operations": [
          {
            "slug": "ping",
            "name": "Ping",
            "summary": "Checks connectivity",
            "binding": { "type": "http", "operation": "GET /ping" }
          }
        ]
      }
    },
    "credentials": {
      "inline": {
        "formatVersion": 1,
        "credentials": [
          {
            "scheme": "basic",
            "slot": "username",
            "value": { "fromEnv": "EXAMPLE_USER" }
          },
          {
            "scheme": "basic",
            "slot": "password",
            "value": { "fromFile": "/run/secrets/example-password" }
          },
          {
            "scheme": "apiKey",
            "slot": "X-Api-Key",
            "location": "header",
            "value": { "fromEnv": "EXAMPLE_API_KEY" }
          },
          {
            "scheme": "apiKey",
            "slot": "access_token",
            "location": "query",
            "value": { "fromEnv": "EXAMPLE_QUERY_KEY" }
          },
          {
            "scheme": "apiKey",
            "slot": "session",
            "location": "cookie",
            "value": { "fromFile": "/run/secrets/example-session" }
          },
          {
            "scheme": "header",
            "slot": "X-Tenant",
            "value": { "fromEnv": "EXAMPLE_TENANT" }
          }
        ]
      }
    }
  }
}
