{
  "manifestFormatVersion": "0.3",
  "sections": {
    "server": {
      "inline": {
        "name": "Search API",
        "surfaces": [
          {
            "slug": "default",
            "isDefault": true,
            "outputSchemas": true,
            "operations": [{ "operation": "search", "exposure": "direct" }]
          }
        ]
      }
    },
    "policy": {
      "inline": {
        "baseUrl": "https://api.example.com",
        "transformCeiling": {
          "maxSteps": 32,
          "maxDepth": 16,
          "maxNodes": 4096,
          "maxOutputBytes": 131072,
          "maxArrayFanout": 256
        }
      }
    },
    "operations": {
      "inline": {
        "operations": [
          {
            "key": "GET /search",
            "method": "GET",
            "path": "/search",
            "summary": "Upstream search",
            "parameters": [
              { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
              { "name": "page_size", "in": "query", "schema": { "type": "integer" } },
              { "name": "X-Api-Version", "in": "header", "schema": { "type": "string" } }
            ],
            "responses": {
              "200": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "hits": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "title": { "type": "string" },
                              "url": { "type": "string" },
                              "internal_score": { "type": "number" }
                            }
                          }
                        },
                        "meta": {
                          "type": "object",
                          "properties": { "total": { "type": "integer" } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "agentSurface": {
      "inline": {
        "operations": [
          {
            "slug": "search",
            "name": "Search",
            "summary": "Searches the index and returns titles with links",
            "inputSchema": {
              "type": "object",
              "required": ["term"],
              "properties": {
                "term": { "type": "string" },
                "limit": { "type": "integer" }
              }
            },
            "outputSchema": {
              "type": "object",
              "properties": {
                "results": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": { "type": "string" },
                      "link": { "type": "string" }
                    }
                  }
                },
                "total": { "type": "integer" }
              }
            },
            "outputSchemaPolicy": { "generate": false, "advertise": "yes", "useInternally": true },
            "annotations": { "readOnly": true, "destructive": false, "idempotent": true, "openWorld": true },
            "risk": "readOnly",
            "binding": {
              "type": "transformedHttp",
              "bindingId": "search-v2",
              "base": { "operation": "GET /search" },
              "inputProgram": {
                "transformVersion": 1,
                "direction": "input",
                "base": "empty",
                "limits": {
                  "maxSteps": 32,
                  "maxDepth": 16,
                  "maxNodes": 4096,
                  "maxOutputBytes": 131072,
                  "maxArrayFanout": 256
                },
                "steps": [
                  { "op": "copy", "source": "/term", "target": "/query/q" },
                  { "op": "copy", "source": "/limit", "target": "/query/page_size", "onMissing": "skip" },
                  { "op": "setConstant", "target": "/headers/X-Api-Version", "value": "2" }
                ]
              },
              "outputProjection": {
                "kind": "transformProgram",
                "program": {
                  "transformVersion": 1,
                  "direction": "output",
                  "base": "empty",
                  "limits": {
                    "maxSteps": 32,
                    "maxDepth": 16,
                    "maxNodes": 4096,
                    "maxOutputBytes": 131072,
                    "maxArrayFanout": 256
                  },
                  "steps": [
                    {
                      "op": "mapArray",
                      "source": "/body/hits",
                      "target": "/results",
                      "maxItems": 10,
                      "steps": [
                        { "op": "copy", "source": "/title", "target": "/title" },
                        { "op": "copy", "source": "/url", "target": "/link" }
                      ]
                    },
                    { "op": "copy", "source": "/body/meta/total", "target": "/total", "onMissing": "skip" }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
