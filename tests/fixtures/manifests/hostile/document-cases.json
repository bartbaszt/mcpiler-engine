    {
      "name": "operations-duplicate-key",
      "code": "operations/duplicate-key",
      "schemaRefuses": false,
      "why": "The execution key is the address a binding resolves. Two operations sharing it would make the executed request depend on declaration order.",
      "manifest": {
        "manifestFormatVersion": "0.1",
        "sections": {
          "server": { "inline": { "name": "Hostile" } },
          "policy": { "inline": { "baseUrl": "https://api.example.com" } },
          "operations": {
            "inline": {
              "operations": [
                { "key": "GET /ping", "method": "GET", "path": "/ping" },
                { "key": "GET /ping", "method": "GET", "path": "/ping" }
              ]
            }
          },
          "agentSurface": { "inline": { "operations": [{ "slug": "ping", "name": "Ping", "binding": { "type": "http", "operation": "GET /ping" } }] } }
        }
      }
    },
    {
      "name": "operations-key-disagrees",
      "code": "operations/key-disagrees-with-method-path",
