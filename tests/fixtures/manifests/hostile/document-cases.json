{
  "note": "Each case is a complete manifest document plus the single diagnostic code it must produce. Cases live here rather than in one directory each because every one of them is a *document* defect; only the bundle/ cases need real files on disk.",
  "cases": [
    {
      "name": "root-not-an-object",
      "code": "manifest/root-not-an-object",
      "schemaRefuses": true,
      "why": "A manifest that is not an object has no grammar at all, so nothing later can be interpreted.",
      "manifest": ["manifestFormatVersion", "0.1"]
    },
    {
      "name": "format-version-missing",
      "code": "manifest/format-version-missing",
      "schemaRefuses": true,
      "why": "Without a declared format version the reader would have to guess which grammar applies.",
      "manifest": {
        "sections": {
          "server": { "inline": { "name": "Hostile" } },
          "policy": { "inline": { "baseUrl": "https://api.example.com" } },
          "operations": { "inline": { "operations": [{ "key": "GET /ping", "method": "GET", "path": "/ping" }] } },
          "agentSurface": { "inline": { "operations": [{ "slug": "ping", "name": "Ping", "binding": { "type": "http", "operation": "GET /ping" } }] } }
        }
      }
    },
    {
      "name": "format-version-unsupported",
      "code": "manifest/format-version-unsupported",
      "schemaRefuses": false,
      "why": "A future major version must be refused with the observed value and the supported range, never partially interpreted.",
      "manifest": {
        "manifestFormatVersion": "9.0",
        "sections": {
          "server": { "inline": { "name": "Hostile" } },
          "policy": { "inline": { "baseUrl": "https://api.example.com" } },
          "operations": { "inline": { "operations": [{ "key": "GET /ping", "method": "GET", "path": "/ping" }] } },
          "agentSurface": { "inline": { "operations": [{ "slug": "ping", "name": "Ping", "binding": { "type": "http", "operation": "GET /ping" } }] } }
        }
      }
    },
    {
      "name": "section-missing",
      "code": "manifest/section-missing",
      "schemaRefuses": true,
      "why": "policy is omitted. The perimeter and the outbound bounds have no safe default, so the manifest cannot load without it.",
      "manifest": {
        "manifestFormatVersion": "0.1",
        "sections": {
          "server": { "inline": { "name": "Hostile" } },
          "operations": { "inline": { "operations": [{ "key": "GET /ping", "method": "GET", "path": "/ping" }] } },
          "agentSurface": { "inline": { "operations": [{ "slug": "ping", "name": "Ping", "binding": { "type": "http", "operation": "GET /ping" } }] } }
        }
      }
    },
    {
      "name": "section-unknown",
      "code": "manifest/section-unknown",
      "schemaRefuses": true,
      "why": "An unknown section name is usually a misspelling of a real one. Ignoring it would silently drop whatever the author intended it to configure.",
      "manifest": {
        "manifestFormatVersion": "0.1",
        "sections": {
          "server": { "inline": { "name": "Hostile" } },
          "policy": { "inline": { "baseUrl": "https://api.example.com" } },
          "polcy": { "inline": { "baseUrl": "https://attacker.example.com" } },
          "operations": { "inline": { "operations": [{ "key": "GET /ping", "method": "GET", "path": "/ping" }] } },
          "agentSurface": { "inline": { "operations": [{ "slug": "ping", "name": "Ping", "binding": { "type": "http", "operation": "GET /ping" } }] } }
        }
      }
    },
    {
      "name": "section-both-inline-and-path",
      "code": "manifest/section-both-inline-and-path",
      "schemaRefuses": true,
      "why": "Two payload sources for one section leave the effective content ambiguous, and a reader that silently prefers one would let the other be a decoy.",
      "manifest": {
        "manifestFormatVersion": "0.1",
        "sections": {
          "server": { "inline": { "name": "Hostile" }, "path": "sections/server.json" },
          "policy": { "inline": { "baseUrl": "https://api.example.com" } },
          "operations": { "inline": { "operations": [{ "key": "GET /ping", "method": "GET", "path": "/ping" }] } },
          "agentSurface": { "inline": { "operations": [{ "slug": "ping", "name": "Ping", "binding": { "type": "http", "operation": "GET /ping" } }] } }
        }
      }
    },
    {
      "name": "section-neither-inline-nor-path",
      "code": "manifest/section-neither-inline-nor-path",
      "schemaRefuses": true,
      "why": "An entry with no payload source is a declaration with nothing behind it.",
      "manifest": {
        "manifestFormatVersion": "0.1",
        "sections": {
          "server": {},
          "policy": { "inline": { "baseUrl": "https://api.example.com" } },
          "operations": { "inline": { "operations": [{ "key": "GET /ping", "method": "GET", "path": "/ping" }] } },
          "agentSurface": { "inline": { "operations": [{ "slug": "ping", "name": "Ping", "binding": { "type": "http", "operation": "GET /ping" } }] } }
        }
      }
    },
    {
      "name": "section-must-be-external",
      "code": "manifest/section-must-be-external",
      "schemaRefuses": true,
      "why": "The vector matrix is a binary payload outside the determinism contract; admitting it inline would put unbounded base64 inside the document the seal covers.",
      "manifest": {
        "manifestFormatVersion": "0.1",
        "sections": {
          "server": { "inline": { "name": "Hostile" } },
          "policy": { "inline": { "baseUrl": "https://api.example.com" } },
          "operations": { "inline": { "operations": [{ "key": "GET /ping", "method": "GET", "path": "/ping" }] } },
          "agentSurface": { "inline": { "operations": [{ "slug": "ping", "name": "Ping", "binding": { "type": "http", "operation": "GET /ping" } }] } },
          "vectors": { "inline": { "ids": [] } }
        }
      }
    },
    {
      "name": "root-unknown-member",
      "code": "manifest/unknown-member",
      "schemaRefuses": true,
      "why": "An unrecognised root member is either a typo or an attempt to smuggle configuration past a strict reader.",
