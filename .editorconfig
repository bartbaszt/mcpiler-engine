root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,razor}]
indent_style = space
indent_size = 4

[*.cs]
# Keep namespaces predictable and make basic code-style hygiene part of the build where Roslyn
# supports build-time enforcement without enabling XML documentation generation.
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_diagnostic.IDE0005.severity = suggestion
dotnet_diagnostic.IDE0065.severity = warning
dotnet_diagnostic.IDE0161.severity = warning

# Recommended SDK analyzers are enabled solution-wide. These rules are intentionally not
# merge blockers because the first full-project run showed that they conflict with MCPiler's
# domain terminology or useful abstraction boundaries, or only propose micro-optimizations.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1720.severity = none
dotnet_diagnostic.CA1822.severity = suggestion
dotnet_diagnostic.CA1859.severity = suggestion
dotnet_diagnostic.CA1873.severity = suggestion

# Meziantou.Analyzer is globally set to MeziantouAnalysisMode=None.
# Only high-signal correctness, security, resource, exception, and async rules are enabled here.
# MA0002 remains visible in the IDE, but choosing Ordinal vs OrdinalIgnoreCase is a semantic
# decision and must not be auto-fixed across the existing model merely to make the rollout green.
dotnet_diagnostic.MA0002.severity = suggestion
dotnet_diagnostic.MA0009.severity = warning
dotnet_diagnostic.MA0012.severity = warning
dotnet_diagnostic.MA0013.severity = warning
dotnet_diagnostic.MA0014.severity = warning
dotnet_diagnostic.MA0015.severity = warning
dotnet_diagnostic.MA0021.severity = warning
dotnet_diagnostic.MA0022.severity = warning
dotnet_diagnostic.MA0024.severity = warning
dotnet_diagnostic.MA0027.severity = warning
dotnet_diagnostic.MA0035.severity = warning
dotnet_diagnostic.MA0037.severity = warning
dotnet_diagnostic.MA0039.severity = warning
dotnet_diagnostic.MA0040.severity = warning
dotnet_diagnostic.MA0054.severity = warning
dotnet_diagnostic.MA0055.severity = warning
dotnet_diagnostic.MA0056.severity = warning
dotnet_diagnostic.MA0060.severity = warning
dotnet_diagnostic.MA0064.severity = warning
dotnet_diagnostic.MA0072.severity = warning
dotnet_diagnostic.MA0082.severity = warning
dotnet_diagnostic.MA0085.severity = warning
dotnet_diagnostic.MA0086.severity = warning
dotnet_diagnostic.MA0100.severity = warning
dotnet_diagnostic.MA0147.severity = warning
dotnet_diagnostic.MA0150.severity = warning

# Threading/async rules. VSTHRD103 flags EF Core DbSet.Add and other fast in-memory Add
# methods in this application, so it is advisory rather than a build gate.
dotnet_diagnostic.VSTHRD002.severity = warning
dotnet_diagnostic.VSTHRD100.severity = warning
dotnet_diagnostic.VSTHRD101.severity = warning
dotnet_diagnostic.VSTHRD103.severity = suggestion
dotnet_diagnostic.VSTHRD105.severity = warning
dotnet_diagnostic.VSTHRD107.severity = warning
dotnet_diagnostic.VSTHRD110.severity = warning
dotnet_diagnostic.VSTHRD114.severity = warning

# Naming-only async migration is useful but intentionally not a merge blocker in the baseline.
dotnet_diagnostic.VSTHRD200.severity = suggestion

