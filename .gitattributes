*.sh text eol=lf
THIRD-PARTY-NOTICES.md text eol=lf

# Release evidence read by LF-sensitive gates. Engine's changelog readers normalize line endings
# explicitly, and this keeps a fresh checkout from materializing the file as CRLF in the first
# place. The release header, Manifest-format and diagnostic-code markers are compared whole-line,
# so a materialized CR would otherwise hide them.
CHANGELOG.md text eol=lf

# This managed-generation corpus is duplicated byte for byte into the MCPiler Platform tree.
# Preserve the committed bytes on checkout so cross-repository byte-identity checks are stable
# when core.autocrlf is enabled on Windows.
tests/fixtures/managed/** -text

# OAuth1 protocol and Manifest fixtures are byte contracts shared with Platform.
tests/fixtures/oauth1/** -text
tests/fixtures/manifests/manifest-0.3/oauth1-authorization/** -text

# The frozen JMESPath profile corpus is duplicated byte for byte into the MCPiler Platform tree.
# The corpus tests compare the two copies with File.ReadAllBytes and the authored expectations are
# canonical JSON output bytes, so a checkout that materialized them as CRLF would change what the
# tests assert and break the cross-repository comparison in one step.
tests/fixtures/jmespath/** -text

# The compatibility contract corpus is duplicated byte for byte into the MCPiler Platform tree.
# Platform compares these copies with File.ReadAllBytes, so a Windows host with core.autocrlf
# enabled must not materialize them as CRLF: the descriptor and the failure table would stop
# being byte-identical to their Platform twins while the committed blobs still match.
tests/fixtures/compatibility/** -text
